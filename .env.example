# --- LLM provider ---
# Provider id: openai-compatible only in MVP (covers OpenAI, Ollama, LM Studio, vLLM, proxies).
# Never commit real keys. API key is env-only, never stored in DB.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Primary model. Leave BLANK to let the provider apply its own default model
# (verified working against the target gateway). Set it only when the
# provider needs an explicit model name. Blank is honoured end-to-end:
# no hardcoded fallback is substituted.
LLM_PRIMARY_MODEL=
# Role models (blank = same as LLM_PRIMARY_MODEL, which may itself be blank):
LLM_STRONG_MODEL=
LLM_CHEAP_MODEL=
LLM_EMBEDDING_MODEL=
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_ATTEMPTS=4
LLM_BACKOFF_BASE_S=1.5
# Docker deployments: containers must reach the LLM provider host. If the
# provider lives on a Tailscale machine, keep the hostname form above and
# ensure docker-compose.yml keeps `dns: [100.100.100.100, 1.1.1.1]`
# (100.100.100.100 = tailnet MagicDNS resolver, 1.1.1.1 = public fallback).
# Bridge traffic NATs out through the host's tailscale0 interface. Do NOT
# pin tailnet IPs via extra_hosts: /etc/hosts outranks DNS and a stale IP
# would break resolution even while MagicDNS is healthy.

# --- Storage ---
# SQLite system of record (WAL). Relative paths resolve against repo root.
DATABASE_PATH=./data/vataic.db
ARTIFACT_DIR=./data/artifacts

# --- Projection budgets / defaults ---
BUDGET_MAX_STEPS=40
BUDGET_MAX_BRANCHES=20
BUDGET_MAX_LLM_CALLS=500
BUDGET_MAX_TOKENS=500000
BUDGET_MAX_RUNTIME_S=28800
BEAM_WIDTH=12
BEAM_RESERVED_DIVERGENT=3
MERGE_DISTANCE_THRESHOLD=8.0
BRANCH_PROB_THRESHOLD=0.15
TAIL_RISK_IMPACT_THRESHOLD=0.8
FACTOR_MAX_MACRO=15
FACTOR_MAX_PERSONAL=18
STEP_MIN_DAYS=7
STEP_MAX_DAYS=365
CHECKPOINT_INTERVAL_MIN=15
EPOCH_INTERVAL_STEPS=4
CONTEXT_TOKEN_BUDGET=6000

# --- Flask ---
FLASK_SECRET_KEY=change-me
PORT=5000

# --- Heuristic escape hatch ---
# Set to 1 to allow scenario execution without a reachable LLM provider
# (deterministic template fallbacks). Default: unset — scenarios fail fast
# at worker pickup with a clear error instead of producing template prose.
VATAIC_ALLOW_HEURISTIC=
