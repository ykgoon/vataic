FROM python:3.11-slim
WORKDIR /srv
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e . && pip install --no-cache-dir gunicorn
COPY app ./app
COPY migrations ./migrations
ENV DATABASE_PATH=/data/vataic.db ARTIFACT_DIR=/data/artifacts
CMD ["sh", "-c", "python -m app.migrate; gunicorn 'app:create_app()' -b 0.0.0.0:5000"]
