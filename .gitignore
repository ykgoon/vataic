# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- venv / uv ---
.venv/
venv/
.uv/

# --- pytest / coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
