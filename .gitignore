!.env.example

# --- runtime data (keep dir via .gitkeep) ---
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*

# --- logs / temp ---
*.log
*.tmp

# --- OS / editors ---
.DS_Store
Thumbs.db
*~
.vscode/
.idea/
