[Unit]
Description=Vataic worker
After=vataic-web.service
[Container]
Image=vataic-worker:latest
Volume=vataic-data.volume:/data
EnvironmentFile=%h/vataic/.env
# Tailscale reachability (see docker-compose.yml): MagicDNS resolver +
# public fallback. Requires the host to be on the tailnet.
DNS=100.100.100.100
DNS=1.1.1.1
Exec=python -m worker.main
[Service]
Restart=always
[Install]
WantedBy=default.target
